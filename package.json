{
  "name": "pi-prompt-pocket",
  "version": "1.0.4",
  "description": "Save, find, edit and reuse titled prompts from Pi's editor.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArdaYILDIZ-DEV/prompt-pocket.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompts"
  ],
  "files": [
    "index.ts",
    "menu.ts",
    "store.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:tui": "node tests/terminal-smoke.mjs regular && node tests/terminal-smoke.mjs fullscreen && node tests/terminal-smoke.mjs fullscreen --custom-editor",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "release": "node scripts/release.mjs",
    "release:pack": "node scripts/release.mjs --current"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
